{
  "name": "stream-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overlays de live para OBS, 100% locais, com edicao ao vivo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "paridade": "node scripts/paridade.mjs",
    "resistencia": "pnpm build && node scripts/resistencia.mjs",
    "dev:server": "pnpm build && node packages/server/dist/cli.js",
    "cenas": "pnpm build && node scripts/cenas.mjs",
    "clean": "find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete && rm -rf packages/*/dist packages/*/dist-types coverage capturas",
    "painel": "pnpm build && node scripts/painel.mjs",
    "verificar": "pnpm check && pnpm cenas && pnpm painel && pnpm resistencia && pnpm paridade",
    "stinger": "pnpm build && node scripts/stinger.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
